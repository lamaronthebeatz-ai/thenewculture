# Copy to .env.local and fill in with your Supabase project's values.
# Cả 2 giá trị này đều AN TOÀN để lộ ra client (anon key không có quyền admin,
# mọi quyền đọc/ghi thật sự do RLS policy trên Supabase quyết định) — KHÔNG
# BAO GIỜ đặt service_role key ở đây hay ở bất kỳ đâu trong dashboard/.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
